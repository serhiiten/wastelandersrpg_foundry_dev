{{!-- «Зробити перевірку» (data-r = field of the panel state; data-action = buttons) --}}
<div class="pust-check-inner">
  <section class="pust-block">
    <div class="pust-row">
      <label>Що перевіряємо</label>
      <select data-r="type">{{#each types}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
    </div>
    {{#if typeHint}}<p class="pust-sub">{{typeHint}}</p>{{/if}}
    <div class="pust-row">
      <select data-r="attr">{{#each attrs}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
      <select data-r="skill">{{#each skills}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
    </div>
    <div class="pust-row">
      <label>Посилення</label>
      <span class="pust-seg">{{#each boost}}<button type="button" class="{{#if on}}on{{/if}}" data-action="set" data-key="boost" data-val="{{n}}">{{n}}</button>{{/each}}</span>
      <label>Послаблення</label>
      <span class="pust-seg">{{#each pen}}<button type="button" class="{{#if on}}on{{/if}}" data-action="set" data-key="pen" data-val="{{n}}">{{n}}</button>{{/each}}</span>
      <label>Мод.</label><input type="text" class="pust-num" data-r="mod" value="{{R.mod}}">
    </div>
    {{#each auto}}
    <label class="pust-tog"><input type="checkbox" data-r="am" data-sub="{{k}}" {{#if on}}checked{{/if}}> {{l}} {{v}}{{#if pen}} Послаблення{{/if}}</label>
    {{/each}}
    {{#if addictions}}
    <label class="pust-tog"><input type="checkbox" data-r="addOn" {{#if addictions.on}}checked{{/if}}> Залежність без дози ({{addictions.n}}): {{addictions.t}}</label>
    {{/if}}
    <div class="pust-tools">
      <button type="button" class="pust-big" data-action="roll"><i class="fa-solid fa-dice-d20"></i> Кинути 2d10</button>
    </div>
    <details><summary>Швидкі перевірки</summary>
      <div class="pust-tools">{{#each presets}}<button type="button" data-action="set" data-key="preset" data-val="{{i}}">{{n}}</button>{{/each}}</div>
    </details>
  </section>

  {{#if last}}
  <section class="pust-block pust-result v{{last.v}}">
    <div class="pust-dice">{{#each last.dice}}<span class="die {{#if kept}}kept{{else}}drop{{/if}}">{{v}}</span>{{/each}}
      {{#if last.skill}} · навичка d{{last.skill.sides}}: <span class="die {{#if last.skill.replaced}}kept{{else}}drop{{/if}}">{{last.skill.v}}</span>{{/if}}
    </div>
    <p>{{last.attr}}{{#if last.mod}}, мод. {{last.mod}}{{/if}}{{#each last.auto}}, {{this}}{{/each}}</p>
    <p class="pust-total"><b>{{last.total}}</b> — {{last.verdict}}{{#if last.aspect}} (з аспектом){{/if}}</p>
    {{#if last.outcome}}<p class="pust-outcome">{{last.outcome}}</p>{{/if}}
    <div class="pust-tools">
      {{#if last.canAspect}}
      <label class="pust-tog"><input type="checkbox" data-r="spend" {{#if R.spend}}checked{{/if}}> витратити жетон Долі ({{fdCur}})</label>
      <button type="button" data-action="aspect">Викликати аспект: +1d10</button>
      {{/if}}
      <button type="button" data-action="xp" data-n="1" data-kind="xp">+1 ОД</button>
    </div>
    {{#if dmgChoices.length}}
    <div class="pust-row">
      <select data-r="dmgKey">{{#each dmgChoices}}<option value="{{key}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
      <label class="pust-tog"><input type="checkbox" data-r="dmgOpt" data-sub="dual" {{#if dmgOpt.dual}}checked{{/if}}> дві зброї</label>
      <label class="pust-tog"><input type="checkbox" data-r="dmgOpt" data-sub="auto" {{#if dmgOpt.auto}}checked{{/if}}> двічі, кращий</label>
      <button type="button" data-action="damage">Кинути шкоду</button>
    </div>
    {{#if last.dmg}}<p class="pust-total">Шкода: <b>{{last.dmg.total}}</b> ({{last.dmg.name}}, {{last.dmg.dstr}}){{#if last.dmg.spent}} — {{last.dmg.spent}}{{/if}}</p>{{/if}}
    {{/if}}
  </section>
  {{/if}}

  <section class="pust-block">
    <h3>Кістка Долі</h3>
    <div class="pust-row">
      <span class="pust-seg">
        <button type="button" class="{{#if fateChar}}on{{/if}}" data-action="set" data-key="fateMode" data-val="char">Удача персонажа</button>
        <button type="button" class="{{#unless fateChar}}on{{/unless}}" data-action="set" data-key="fateMode" data-val="party">Удача партії</button>
      </span>
      {{#unless fateChar}}<select data-r="party">{{#each party}}<option value="{{n}}" {{#if sel}}selected{{/if}}>{{s}}</option>{{/each}}</select>{{/unless}}
      <button type="button" data-action="fate">Кинути 1d10</button>
      {{#if fate}}<b>{{fate.total}}</b>{{/if}}
    </div>
    <h3>Просто кістки</h3>
    <div class="pust-row">
      {{#each pool}}<span class="pust-seg"><button type="button" data-action="set" data-key="pool" data-k="{{k}}" data-val="-1">−</button><b>{{n}}d{{k}}</b><button type="button" data-action="set" data-key="pool" data-k="{{k}}" data-val="1">+</button></span>{{/each}}
      <button type="button" data-action="pool">Кинути</button>
      {{#if poolRes}}<b>{{poolRes.total}}</b>{{/if}}
    </div>
  </section>

  {{#if hist.length}}
  <section class="pust-block">
    <h3>Історія</h3>
    {{#each hist}}<div class="pust-hist {{cls}}"><b>{{total}}</b> {{label}}</div>{{/each}}
  </section>
  {{/if}}
</div>
