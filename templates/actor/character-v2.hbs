          <label class="pust-gf2"><span class="pust-fchip">Дальність</span><select data-k="weapons.{{i}}.r" aria-label="Дальність">{{#each rangeOptions}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>
          <label class="pust-gf2"><span class="pust-fchip">Режим вогню</span><select data-k="weapons.{{i}}.rof" aria-label="Режим вогню">{{#each rofOptions}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>
          <label class="pust-gf2"><span class="pust-fchip">Клас</span><select data-k="weapons.{{i}}.cls" aria-label="Клас">{{#each clsOptions}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>
          {{#each mods}}<div class="pust-gf2 pust-gc-full pust-modrow"><span class="pust-fchip">Мод {{add j 1}}</span>
            <span class="pust-sitchip pust-modchip {{#unless set}}empty{{/unless}}"><textarea rows="1" data-k="weapons.{{../i}}.mods.{{j}}.n" placeholder="назва модифікації" class="pust-mod" aria-label="Модифікація {{add j 1}}">{{n}}</textarea>
              {{#if set}}<span class="pust-sinv" title="Безкоштовні Посилення: на сесію {{#if crit}}2{{else}}1{{/if}}"><button type="button" data-action="act" data-act="mod-inv" data-l="weapons" data-i="{{../i}}" data-j="{{j}}" data-d="-1" {{#unless inv}}disabled{{/unless}} aria-label="Мінус 1 безкоштовне Посилення">−</button><b>+{{inv}}</b><button type="button" data-action="act" data-act="mod-inv" data-l="weapons" data-i="{{../i}}" data-j="{{j}}" data-d="1" aria-label="Плюс 1 безкоштовне Посилення">+</button></span>
              <button type="button" class="pust-modcrit {{#if crit}}on{{/if}}" data-action="act" data-act="mod-crit" data-l="weapons" data-i="{{../i}}" data-j="{{j}}" aria-pressed="{{#if crit}}true{{else}}false{{/if}}" title="Модифікація вийшла дуже вдалою (19+): 2 безкоштовні Посилення на сесію">крит</button>{{/if}}</span></div>{{/each}}
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      <div class="pust-tools"><button type="button" class="pust-go pust-addbtn {{#if (eq v.addPick "weapons")}}on{{/if}}" data-action="addPick" data-l="weapons" title="Додати з довідника або порожній рядок"><i class="fa-solid fa-plus"></i> Зброя</button>
      </div>
      {{#if (eq v.addPick "weapons")}}<div class="pust-addcat">
        <div class="pust-addcat-bar"><i class="fa-solid fa-book-open"></i>
          <input type="text" placeholder="Пошук у довіднику" data-ui="addQ" value="{{v.addQ}}">
          <select data-ui="catSort" title="Сортування">{{#each v.catSorts}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
          <button type="button" class="pust-x" data-action="addPick" data-l="" title="Сховати довідник"><i class="fa-solid fa-xmark"></i></button></div>
        <div class="pust-addcat-list">
          <div class="pust-cat-row pust-cat-blank"><span><b>Інше</b> <small class="pust-sub">порожня річ — заповни сам</small></span>
            <button type="button" class="pust-pick-add" data-action="act" data-act="row-add" data-l="weapons"><i class="fa-solid fa-plus"></i> Додати</button></div>
          {{#each v.addCat.groups}}<h4>{{g}}</h4>
          {{#each items}}<div class="pust-cat-row"><span class="pust-cat-name"><b>{{n}}</b>{{#if d}} <small class="pust-cat-d">{{d}}</small>{{/if}}{{#if addict}} <small class="pust-cat-addict" title="Кидок d10: {{addict}} або менше — залежність">залежність {{addict}}/10</small>{{/if}}{{#if desc}} <small class="pust-cat-desc">— {{desc}}</small>{{/if}}</span>{{#if price}}<small class="pust-cat-price">{{price}} к</small>{{/if}}
            <button type="button" class="pust-pick-add" data-action="act" data-act="cat-add" data-id="{{id}}"><i class="fa-solid fa-plus"></i> Додати</button></div>{{/each}}
          {{else}}<p class="pust-sub">Нічого не знайдено.</p>{{/each}}
        </div>
      </div>{{/if}}
    </section>

    <section class="pust-block">
      <h3>Броня</h3>
      {{#if v.armorList.length}}
      <div class="pust-gcards pust-gcards-armor">
        {{#each v.armorList}}
        <div class="pust-gcard pust-gc kind-{{kind}} {{#if w}}on{{/if}}">
