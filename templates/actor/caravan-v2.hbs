{{!-- Електронний аркуш каравану (Foundry), laid out like the character sheet. Fields: data-k = field of the HTML caravan sheet; buttons: data-act. --}}
<div class="pust-sheet-inner pust-caravan {{#unless editable}}readonly{{/unless}}">

  {{!-- ===== Аркуш: file, random, quick start, clear (folds; above the name) ===== --}}
  <details class="pust-sheetbar pust-fold" data-fold="sheetBarOpen" {{#if ui.sheetBarOpen}}open{{/if}}>
    <summary title="Розгорнути чи згорнути"><i class="fa-solid fa-chevron-right pust-fold-ico"></i> <i class="fa-solid fa-file-lines"></i> Аркуш</summary>
    <div class="pust-sheetbar-btns">
      <button type="button" data-action="jsonOpen"><i class="fa-solid fa-folder-open"></i> Відкрити .json</button>
      <button type="button" data-action="jsonSave"><i class="fa-solid fa-floppy-disk"></i> Зберегти .json</button>
      <button type="button" class="pust-random" data-action="cact" data-act="random" data-confirm="1" title="Заповнене вручну (назва, аспекти, записи) лишиться"><i class="fa-solid fa-dice"></i> Випадковий караван</button>
      <button type="button" data-action="cact" data-act="quick" data-confirm="1" title="Замінити караван готовим"><i class="fa-solid fa-person-running"></i> Швидкий старт</button>
      <button type="button" data-action="cact" data-act="clear" data-confirm="1" class="pust-danger"><i class="fa-solid fa-eraser"></i> Очистити аркуш</button>
      <button type="button" data-action="uiToggle" data-key="guide"><i class="fa-solid fa-circle-question"></i> Як створити караван</button>
    </div>
  </details>

  {{#if v.guide}}
  <section class="pust-block pust-guide">
    <h3>Як створити караван</h3>
    <ol>{{#each v.guide}}<li>{{t}}</li>{{/each}}</ol>
  </section>
  {{/if}}

  {{!-- ===== Караван: назва, транспорт, Удача, карма, репутація ===== --}}
  <header class="pust-head">
    <div class="pust-who">
      <div class="pust-row">
        <input type="text" class="pust-name" data-k="companyName" value="{{v.name}}" placeholder="Вигадайте назву" aria-label="Назва компанії">
        {{#if undo}}<button type="button" class="pust-undo" data-action="undo" title="Повернути аркуш, яким він був до останньої дії"><i class="fa-solid fa-rotate-left"></i> Скасувати</button>{{/if}}
        <button type="button" class="pust-die {{#if v.locks.name}}locked{{/if}}" data-action="cact" data-act="rollName" title="{{#if v.locks.name}}Заповнено вручну. Очистіть поле, щоб знову кидати кістки{{else}}Кинути на назву компанії{{/if}}"><i class="fa-solid {{#if v.locks.name}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
      </div>
      <div class="pust-row pust-vrow">
        <span class="pust-hlab">Транспорт</span>
        <span class="pust-seg">
          <button type="button" class="{{#unless v.tachka}}on{{/unless}}" data-action="cact" data-act="veh" data-veh="0">Браміни</button>
          <button type="button" class="{{#if v.tachka}}on{{/if}}" data-action="cact" data-act="veh" data-veh="1">Тачка</button>
        </span>
        <span class="pust-hlab">Удача партії</span>
        <select data-k="luck" aria-label="Удача партії">{{#each v.luck}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
      </div>
      <div class="pust-row pust-aspect asp-goal">
        <label>Карма</label>
        <select data-k="karmaAspect" aria-label="Кармічний аспект">{{#each v.karmaAspects}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
        <button type="button" class="pust-die {{#if v.locks.karma}}locked{{/if}}" data-action="cact" data-act="rollKarma" title="{{#if v.locks.karma}}Заповнено вручну. Змініть кармічний аспект або карму, щоб знову кидати кістки{{else}}Кинути d6 на карму{{/if}}"><i class="fa-solid {{#if v.locks.karma}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
      </div>
      <div class="pust-row pust-aspect asp-concept">
        <label>Репутація</label>
        <textarea class="pust-asp-ta" rows="1" data-k="reputation" aria-label="Репутація">{{v.reputation}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.rep}}locked{{/if}}" data-action="cact" data-act="rollRep" title="{{#if v.locks.rep}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути репутаційний аспект{{/if}}"><i class="fa-solid {{#if v.locks.rep}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
      </div>
    </div>
  </header>

  {{!-- ===== Швидкий доступ ===== --}}
  <section class="pust-quickbar {{#if quickFold}}folded{{/if}}">
    <button type="button" class="pust-qfold" data-action="uiToggle" data-key="quickFold" title="{{#if quickFold}}Розгорнути швидкий доступ{{else}}Згорнути швидкий доступ{{/if}}"><i class="fa-solid {{#if quickFold}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i></button>
    <div class="pust-qgrid">
      <div class="pust-qgrp q-life">
        <div class="pust-qi q-hp {{#if (lt v.hpCurrent 1)}}bad{{/if}}"><span>Очки здоров'я</span><div>
          <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="-1" title="Мінус 1 ОЗ">−</button>
          <input type="text" class="pust-screen" data-k="hpCurrent" value="{{v.hpCurrent}}" aria-label="Поточні ОЗ">
          <span class="pust-qsep">/</span>
          <input type="text" class="pust-qmax {{#if v.hpCustom}}custom{{/if}}" data-k="hpMax" value="{{v.maxHP}}" aria-label="Максимум ОЗ" title="{{#if v.hpCustom}}Встановлено вручну. Стандартно: {{v.baseMaxHP}}{{else}}Максимум ОЗ можна змінити вручну{{/if}}">
          <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="1" title="Плюс 1 ОЗ">+</button>
          {{#if v.hpCustom}}<button type="button" data-action="cact" data-act="hpMaxReset" title="Повернути стандартний максимум ({{v.baseMaxHP}})">↺</button>{{/if}}
        </div></div>
        <div class="pust-qi q-arm"><span>Броня</span><div>
          <input type="text" class="{{#if v.armorCustom}}custom{{/if}}" data-k="armorVal" value="{{v.armor}}" aria-label="Броня" title="{{#if v.armorCustom}}Встановлено вручну. Стандартно: {{v.baseArmor}}{{else}}Броню можна змінити вручну{{/if}}">
          <input type="text" class="pust-qarmtype {{#if v.armorTypeCustom}}custom{{/if}}" data-k="armorType" value="{{v.armorType}}" aria-label="Тип броні" title="Тип броні">
          {{#if (or v.armorCustom v.armorTypeCustom)}}<button type="button" data-action="cact" data-act="armorReset" title="Повернути стандартну броню ({{v.baseArmor}}, фізична)">↺</button>{{/if}}
        </div></div>
        <div class="pust-hpbar hp-{{v.hpBar.level}}" title="Очки здоров'я: {{v.hpCurrent}} з {{v.maxHP}}" aria-hidden="true">
          <div class="pust-hpbar-fill" style="width: {{v.hpBar.pct}}%"></div>
          <span class="pust-hpbar-t"><b>ОЗ</b> {{v.hpCurrent}}/{{v.maxHP}}</span>
        </div>
      </div>
      <div class="pust-qgrp q-move">
        <div class="pust-qi q-movecell"><span>Запас ходу</span>
          <div class="q-moverow">
            <div class="pust-qpips">
            {{#each v.movePips1}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" {{#unless avail}}disabled{{/unless}}></button>{{/each}}
            {{#each v.movePips2}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" {{#unless avail}}disabled{{/unless}}></button>{{/each}}
            </div>
            <b>{{v.moveNow}}</b>
          </div>
          <small>{{v.cellRule}} · {{v.refill}}</small></div>
      </div>
      <div class="pust-qgrp q-goods">
        <div class="pust-qi"><span>Бюджет кришок</span><div>
          <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="-1" title="Мінус 1 кришка">−</button>
          <input type="text" class="pust-screen" data-k="budget" value="{{v.budget}}" aria-label="Бюджет кришок">
          <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="1" title="Плюс 1 кришка">+</button>
          <button type="button" class="pust-die {{#if v.locks.budget}}locked{{/if}}" data-action="cact" data-act="rollBudget" title="{{#if v.locks.budget}}Заповнено вручну. Змініть бюджет, щоб знову кидати кістки{{else}}Кинути 1d6 + 4{{/if}}"><i class="fa-solid {{#if v.locks.budget}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
        </div></div>
        <div class="pust-qi"><span>Карма</span><div>
          <button type="button" data-action="cact" data-act="step" data-step="karma" data-d="-1" title="Мінус 1 карми">−</button>
          <input type="text" class="pust-screen" data-k="karma" value="{{v.karma}}" aria-label="Карма">
          <button type="button" data-action="cact" data-act="step" data-step="karma" data-d="1" title="Плюс 1 карми">+</button>
        </div></div>
        {{#if v.supLamps}}
        <div class="pust-qi"><span>Припаси</span><div class="pust-qlamps">
          {{#each v.supLamps}}<button type="button" class="pust-qlamp dot {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="sup" data-i="{{k}}" title="Припасів: {{n}}" aria-label="Припасів: {{n}}"></button>{{/each}}
        </div></div>
        {{else}}
        <div class="pust-qi"><span>Припаси</span><div class="pust-qnone">немає скриньки</div></div>
        {{/if}}
      </div>
      <div class="pust-qi pust-qroll">
        <button type="button" class="pust-check-btn" data-action="cact" data-act="rollFate" title="Кістка Долі: 1d10 + Удача партії, 6 і вище — на користь персонажів"><i class="fa-solid fa-dice-d10"></i> Кістка Долі</button>
      </div>
    </div>

    <div class="pust-qstat pust-qline">
      <span class="pust-qline-i">{{#if v.repair}}Пошкоджено на <b>{{v.repair.dmg}}</b> ОЗ · ремонт у техніка: <b>{{v.repair.cost}}(к)</b> (1(к) за 5 ОЗ){{#if v.repair.hurt}} · <b class="bad">вантаж постраждав</b>: шкоди більше ніж на половину ОЗ{{/if}}{{#if v.repair.destroyed}} · <b class="bad">ОЗ 0 — вантаж знищено</b>{{/if}}{{else}}Караван цілий{{/if}}</span>
      <span class="pust-qline-i">Покращень: <b class="{{#if v.impNeed}}bad{{/if}}">{{v.impCount}}</b> <small>({{v.impHint}})</small></span>
      <span class="pust-qline-i">Вантаж: <b class="{{#if v.cargoOver}}bad{{/if}}">{{v.cargoNow}}</b> <span class="pust-meter {{#if v.cargoOver}}warn{{/if}}"><span style="width: {{v.cargoPct}}%"></span></span></span>
    </div>
  </section>


  <nav class="pust-tabs">
    <a data-action="pustTab" data-tab="imps" class="{{#if (eq tab 'imps')}}active{{/if}}">Покращення</a>
    <a data-action="pustTab" data-tab="cargo" class="{{#if (eq tab 'cargo')}}active{{/if}}">Вантаж і пасажири</a>
    <a data-action="pustTab" data-tab="counters" class="{{#if (eq tab 'counters')}}active{{/if}}">Лічильники</a>
    <a data-action="pustTab" data-tab="story" class="{{#if (eq tab 'story')}}active{{/if}}">Історія</a>
  </nav>

  <div class="pust-body">

  {{!-- ===== Покращення ===== --}}
  {{#if (eq tab 'imps')}}
    <div class="pust-tools pust-tools-top pust-imp-bar">
      <button type="button" class="pust-fold" data-action="uiToggle" data-key="foldImps" title="{{#if v.foldImps}}Показати всі покращення{{else}}Показати лише взяті{{/if}}"><i class="fa-solid {{#if v.foldImps}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i> {{#if v.foldImps}}Усі покращення{{else}}Лише взяті{{/if}}</button>
      <button type="button" class="pust-die {{#if v.locks.imps}}locked{{/if}}" data-action="cact" data-act="rollImps" data-confirm="1" title="{{#if v.locks.imps}}Покращення обрано вручну. Зніміть усі позначки, щоб знову кидати{{else}}Обрати 2 випадкові покращення замість поточних{{/if}}"><i class="fa-solid {{#if v.locks.imps}}fa-lock{{else}}fa-dice{{/if}}"></i> 2 випадкові</button>
    </div>
    {{#if v.foldEmpty}}<p class="pust-sub">Покращень ще не взято. Розгорніть список, щоб обрати.</p>{{/if}}
    {{#each v.imps}}
    {{#unless hidden}}
    <div class="pust-item pust-card pust-imp {{#if taken}}taken{{/if}} {{#if locked}}locked{{/if}}">
      <div class="pust-item-head">
        <b>{{name}}</b>
        {{#if sub}}<small class="pust-sub">{{sub}}</small>{{/if}}
        <span class="pust-imp-ctrl">
          {{#if supPips}}<span class="pust-pips">{{#each supPips}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="sup" data-i="{{k}}"></button>{{/each}}</span>{{/if}}
          {{#each btns}}<button type="button" class="rbtn {{#if on}}on{{/if}}" data-action="cact" data-act="imp" data-id="{{../id}}" data-k="{{k}}" {{#if ../locked}}disabled{{/if}}></button>{{/each}}
        </span>
      </div>
      <div class="pust-text">{{desc}}</div>
    </div>
    {{/unless}}
    {{/each}}
    {{#each v.customImps}}
    <div class="pust-item pust-card pust-imp taken custom">
      <div class="pust-item-head">
        <input type="text" class="pust-imp-name" data-k="customImps.{{i}}.name" value="{{name}}" placeholder="Назва" aria-label="Назва покращення">
        <small class="pust-sub">Власне покращення</small>
        <button type="button" class="pust-x" data-action="cact" data-act="cimp-del" data-i="{{i}}" data-confirm="1" title="Видалити власне покращення"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <textarea class="pust-asp-ta" rows="1" data-k="customImps.{{i}}.desc" placeholder="Що воно дає каравану" aria-label="Опис покращення">{{desc}}</textarea>
    </div>
    {{/each}}
    <div class="pust-tools"><button type="button" data-action="cact" data-act="addCustomImp">+ Власне покращення</button></div>
  {{/if}}

  {{!-- ===== Вантаж і пасажири ===== --}}
  {{#if (eq tab 'cargo')}}
    {{#if v.cargo.length}}
    <div class="pust-glist pust-glist-cargo">
      <div class="pust-grow pust-ghead"><span>Назва</span><span>Примітка</span><span>Тип</span><span>Ціна</span><span>К-сть</span><span>Сума</span><span><i class="fa-solid fa-xmark"></i></span></div>
      {{#each v.cargo}}
      <div class="pust-grow">
        <input type="text" class="pust-gname" data-k="cargo.{{i}}.name" value="{{name}}" placeholder="Що везете" aria-label="Назва">
        <textarea class="pust-gnote-in pust-cnote" rows="1" data-k="cargo.{{i}}.note" placeholder="Куди, кому, умови" aria-label="Куди, кому, умови">{{note}}</textarea>
        <select data-k="cargo.{{i}}.kind" aria-label="Тип"><option value="cargo" {{#unless pass}}selected{{/unless}}>Вантаж</option><option value="pass" {{#if pass}}selected{{/if}}>Пасажир</option></select>
        <input type="text" class="pust-price" data-k="cargo.{{i}}.price" value="{{price}}" placeholder="Ціна" aria-label="Ціна">
        <input type="text" class="pust-qty" data-k="cargo.{{i}}.qty" value="{{qty}}" placeholder="К-сть" aria-label="Кількість">
        <b class="pust-csum">{{sum}}</b>
        <button type="button" class="pust-x" data-action="cact" data-act="cg-del" data-i="{{i}}" data-confirm="1" title="Видалити рядок"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="pust-sub">Порожньо. За замовчуванням у караван влазить добра на суму до 10 кришок.</p>
    {{/if}}
    <div class="pust-tools">
      <button type="button" data-action="cact" data-act="addCargo">+ Рядок</button>
      <button type="button" class="{{#if v.longHaul}}on{{/if}}" data-action="cact" data-act="longHaul" title="Далека доставка (понад 15 клітин): продаж ще на ½ ціни дорожчий">Далека доставка</button>
    </div>
    <p class="pust-log">{{#if v.cargoSummary}}Вантаж: <b>{{v.cargoSummary.val}} / {{v.cargoSummary.cap}}(к)</b>{{#if v.cargoSummary.over}} — <b class="bad">перевантаження</b>{{/if}} · продаж: <b>{{v.cargoSummary.sale}}(к)</b> (пошкоджений <b>{{v.cargoSummary.saleHurt}}(к)</b>){{#if v.cargoSummary.passengers}} · пасажирів: <b>{{v.cargoSummary.passengers}}</b>{{/if}}{{else}}Місткість: <b>{{v.cargoCap}}(к)</b> вантажу{{/if}}</p>
  {{/if}}

  {{!-- ===== Лічильники ===== --}}
  {{#if (eq tab 'counters')}}
    {{#each v.counters}}
    <div class="pust-item pust-card pust-ctr">
      <input type="text" class="pust-ctr-name" data-k="counters.{{i}}.name" value="{{name}}" placeholder="Назва лічильника" aria-label="Назва лічильника">
      <span class="pust-segs">{{#each segs}}<button type="button" class="seg {{#if on}}on{{/if}}" data-action="cact" data-act="seg" data-seg="{{../i}}" data-k="{{k}}"></button>{{/each}}</span>
      <select data-k="counters.{{i}}.size" aria-label="Кількість поділок">{{#each sizes}}<option value="{{n}}" {{#if sel}}selected{{/if}}>{{n}} поділок</option>{{/each}}</select>
      <button type="button" class="pust-x" data-action="cact" data-act="cnt-del" data-i="{{i}}" data-confirm="1" title="Видалити лічильник"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{else}}
    <p class="pust-sub">Лічильників поки немає. Додайте, наприклад, «Наступ Легіону» на 10 поділок.</p>
    {{/each}}
    <div class="pust-tools"><button type="button" data-action="cact" data-act="addCounter">+ Лічильник</button></div>
  {{/if}}

  {{!-- ===== Історія каравану ===== --}}
  {{#if (eq tab 'story')}}
    <div class="pust-story">
      <div class="pust-row pust-aspect asp-concept"><label>Як ви познайомилися?</label><textarea class="pust-asp-ta" rows="1" data-k="story.meeting" aria-label="Як ви познайомилися?">{{v.story.meeting}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.meeting}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="meeting" title="{{#if v.locks.meeting}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.meeting}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
      <div class="pust-row pust-aspect asp-problem"><label>Обличчя компанії</label><textarea class="pust-asp-ta" rows="1" data-k="story.face" aria-label="Обличчя компанії">{{v.story.face}}</textarea></div>
      <div class="pust-row pust-aspect asp-goal"><label>Остання справа</label><textarea class="pust-asp-ta" rows="1" data-k="story.lastJob" aria-label="Остання справа">{{v.story.lastJob}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.lastJob}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="lastJob" title="{{#if v.locks.lastJob}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.lastJob}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
      <div class="pust-row pust-aspect asp-detail"><label>Що пішло не так</label><textarea class="pust-asp-ta" rows="1" data-k="story.wentWrong" aria-label="Що пішло не так">{{v.story.wentWrong}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.wentWrong}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="wentWrong" title="{{#if v.locks.wentWrong}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.wentWrong}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
    </div>
    <h4>Примітки</h4>
    <textarea class="pust-notes" data-k="notes" rows="5" aria-label="Примітки">{{v.notes}}</textarea>
  {{/if}}

  </div>
</div>
