{{!-- Електронний аркуш каравану (Foundry), laid out like the character sheet. Fields: data-k = field of the HTML caravan sheet; buttons: data-act. --}}
<div class="pust-sheet-inner pust-caravan {{#unless editable}}readonly{{/unless}} {{#if compact}}pust-compact{{/if}}">

  {{#if compact}}
  {{!-- ===== Компактний аркуш каравану (author, 2026-11-18; mockup Б1 «Дзеркало персонажа»): what the table needs on the road —
       the head, karma and reputation as chips, «Швидкий доступ», «Вантаж» as chips, the taken «Покращення» with their actions.
       Making and setting up the caravan (choosing improvements, story, «Налаштування») stays in the full sheet ===== --}}
  <header class="pust-cmp-head">
    <img class="pust-cmp-portrait" src="{{ccmp.img}}" alt="">
    <div class="pust-cmp-who"><b class="pust-cmp-name">{{#if v.name}}{{v.name}}{{else}}Караван без назви{{/if}}</b><small>{{#if v.tachka}}Тачка{{else}}Браміни{{/if}} · Удача партії {{ccmp.luck}}</small></div>
    <span class="pust-seg pust-cmp-seg" role="group" aria-label="Вигляд аркуша"><button type="button" data-action="compactToggle" data-v="0" title="Повний аркуш: створення й налаштування каравану">Повний</button><button type="button" class="on" data-action="compactToggle" data-v="1" title="Компактний аркуш: лише потрібне в дорозі">Компактний</button></span>
  </header>
  <div class="pust-cmp-asps">
    <span class="pust-cmp-asp pust-ccmp-karma karma-{{ccmp.karmaTone}}" title="{{ccmp.karmaTip}}"><b>Карма</b><span class="pust-ccmp-kv">{{#if editable}}<button type="button" data-action="cact" data-act="step" data-step="karma" data-d="-1" title="Мінус 1 карми" aria-label="Мінус 1 карми">−</button>{{/if}}<input type="text" class="pust-screen" data-k="karma" value="{{v.karma}}" aria-label="Карма" title="Карма">{{#if editable}}<button type="button" data-action="cact" data-act="step" data-step="karma" data-d="1" title="Плюс 1 карми" aria-label="Плюс 1 карми">+</button>{{/if}}{{#if ccmp.karmaAspect}}<span class="pust-ccmp-ka">{{ccmp.karmaAspect}}</span>{{/if}}</span></span>
    {{#if v.reputation}}<span class="pust-cmp-asp asp-concept"><b>Репутація</b><span>{{v.reputation}}</span></span>{{/if}}
  </div>

  {{!-- «Швидкий доступ»: ОЗ with «Відремонтувати», Броня, Бюджет; «Запас ходу» the whole width with its lamps --}}
  <section class="pust-ccmp-quick">
    <div class="pust-ccmp-chip {{#if (lt v.hpCurrent 1)}}bad{{/if}}" title="Очки здоров'я каравану: {{v.hpCurrent}} з {{v.maxHP}}">
      <i class="fa-solid fa-heart-pulse pust-qic" aria-hidden="true"></i>
      <div class="pust-ccmp-ctl">
        <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="-1" title="Мінус 1 ОЗ" aria-label="Мінус 1 ОЗ">−</button>
        <input type="text" class="pust-screen" data-k="hpCurrent" value="{{v.hpCurrent}}" aria-label="Поточні ОЗ"><b class="pust-ccmp-of">/ {{v.maxHP}}</b>
        <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="1" title="Плюс 1 ОЗ" aria-label="Плюс 1 ОЗ">+</button>
      </div>
      <span class="pust-ccmp-hpline hp-{{v.hpBar.level}}" aria-hidden="true"><i style="width: {{v.hpBar.pct}}%"></i></span>
      {{#if editable}}<button type="button" class="pust-ccmp-svc" data-action="cact" data-act="repair" title="{{v.repairBtn.title}}" aria-label="{{v.repairBtn.label}}" {{#if v.repairBtn.off}}disabled{{/if}}><i class="fa-solid fa-screwdriver-wrench"></i></button>{{/if}}
    </div>
    <div class="pust-ccmp-chip" title="Броня каравану: {{v.armor}}">
      <i class="fa-solid fa-shield-halved pust-qic" aria-hidden="true"></i>
      <span class="pust-ccmp-scr">{{v.armor}}</span>
    </div>
    <div class="pust-ccmp-chip" title="Бюджет кришок: {{v.budget}}(к)">
      <i class="fa-solid fa-coins pust-qic" aria-hidden="true"></i>
      <div class="pust-ccmp-ctl">
        <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="-1" title="Мінус 1 кришка" aria-label="Мінус 1 кришка">−</button>
        <input type="text" class="pust-screen" data-k="budget" value="{{v.budget}}" aria-label="Бюджет кришок">
        <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="1" title="Плюс 1 кришка" aria-label="Плюс 1 кришка">+</button>
      </div>
    </div>
    <div class="pust-ccmp-chip pust-ccmp-move">
      <div class="pust-ccmp-mvhd">
        <i class="fa-solid fa-route pust-qic" aria-hidden="true"></i><b title="{{v.refill}} · {{v.cellRule}}">Запас ходу {{v.moveNow}}</b>
        {{#if editable}}<button type="button" class="pust-autorange {{#if autoRange}}on{{/if}}" data-action="autoRange" role="switch" aria-checked="{{#if autoRange}}true{{else}}false{{/if}}" title="Витрачати автоматично: коли караван переміщують на мапі, запас ходу списується сам, без питання (1 клітина — 1 одиниця, тачка — 3 клітини за одиницю). Якщо запасу бракує, караван лишається на місці."><span class="pust-place-sw" aria-hidden="true"></span><span>Витрачати автоматично</span></button>
        <button type="button" class="pust-ccmp-svc" data-action="cact" data-act="refill" title="{{v.refillBtn.title}}" aria-label="{{v.refillBtn.label}}" {{#if v.refillBtn.off}}disabled{{/if}}><i class="fa-solid fa-gas-pump"></i></button>{{/if}}
      </div>
      <div class="pust-qpips pust-ccmp-pips">
        {{#each v.movePips1}}{{#if avail}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" aria-label="Запас ходу"></button>{{/if}}{{/each}}
        {{#each v.movePips2}}{{#if avail}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" aria-label="Запас ходу"></button>{{/if}}{{/each}}
      </div>
    </div>
  </section>

  {{!-- «Покращення» over «Вантаж» (author, 2026-11-18; playtest item 11, mockup А): the ones with an action as cards like the
       perks — name, limit, one sentence, the action (the turret rolls, «Дефібрилятор» «Застосувати» and a scene mark, no
       Припас spent by itself; the brahmins' choice for the trip; the chest's Припаси) —, the rest as quiet chips at the foot --}}
  <section class="pust-block pust-ccmp-imps">
    <h3><i class="fa-solid fa-gears pust-qic" aria-hidden="true"></i>Покращення <small class="pust-cmp-pkn">{{v.impCount}}</small></h3>
    {{#each ccmp.impCards}}
    <div class="pust-pkuse pk-{{cls}} pust-ccmp-icard{{#if defib.used}} used{{/if}}">
      <div class="pust-pkuse-top">
        <span class="pust-pkuse-n" title="{{desc}}">{{name}}{{#if level}} <small>×{{level}}</small>{{/if}}</span>
        {{#if lim}}<span class="pust-pklim pk-{{cls}}">{{lim}}</span>{{/if}}
        <span class="pust-ccmp-iact">
        {{#if (eq id "turret")}}{{#if @root.turret}}{{#if @root.editable}}<button type="button" class="pust-turret-dice {{@root.turret.tcls}}" data-action="turretRoll" title="Кинути шкоду турелі в чат"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i>{{@root.turret.diceText}}</button><button type="button" class="pust-turret-hit" data-action="turretHit" title="Вистрілити з турелі по цілях: броня й стійкості кожного враховуються" aria-label="Завдати цілям"><i class="fa-solid fa-crosshairs"></i></button>{{else}}<span class="pust-turret-dice {{@root.turret.tcls}}">{{@root.turret.diceText}}</span>{{/if}}{{/if}}{{/if}}
        {{#if defib}}{{#unless defib.used}}{{#if @root.editable}}<button type="button" class="pust-pkuse-go" data-action="defib" data-v="1" title="Застосувати: позначений ціллю (T) персонаж з 0 ОЗ повертається в сцену з 1 ОЗ; картка в чат і позначка до кінця сцени. Одиницю Припасів зніміть самі.">Застосувати</button>{{/if}}{{/unless}}{{/if}}
        {{#if supPips}}<span class="pust-pips">{{#each supPips}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="sup" data-i="{{k}}"></button>{{/each}}</span>{{/if}}
        {{#if (eq id "brahmins")}}{{#if @root.editable}}<span class="pust-seg2"><button type="button" class="{{#if @root.brahmins.range}}on{{/if}}" data-action="brahminBonus" data-v="range" title="Караван витрачає менше запасу ходу">−{{@root.brahmins.share}} запасу</button><button type="button" class="{{#unless @root.brahmins.range}}on{{/unless}}" data-action="brahminBonus" data-v="time" title="Шлях займає менше часу">−{{@root.brahmins.share}} часу</button></span>{{/if}}{{/if}}
        </span>
      </div>
      <p class="pust-pkuse-t">{{#if defib.used}}<b class="pust-pkuse-usedtag">Використано</b> · повернеться після «Кінця сцени» Доглядача.{{#if @root.editable}} <button type="button" class="pust-pkuse-free" data-action="defib" data-v="0" title="Зняти позначку «використано»"><i class="fa-solid fa-rotate-left"></i> Зняти позначку</button>{{/if}}{{else}}{{short}}{{/if}}</p>
    </div>
    {{/each}}
    {{#if (or ccmp.impQuiet.length v.customImps.length)}}<div class="pust-cmp-passive">{{#each ccmp.impQuiet}}<span class="pust-cmp-pchip" title="{{desc}}">{{name}}{{#if level}} ×{{level}}{{/if}}</span>{{/each}}{{#each v.customImps}}<span class="pust-cmp-pchip" title="{{desc}}">{{#if name}}{{name}}{{else}}Власне покращення{{/if}}</span>{{/each}}</div>{{/if}}
    {{#unless ccmp.impCards.length}}{{#unless ccmp.impQuiet.length}}{{#unless v.customImps.length}}<span class="pust-sub">Покращень ще не взято: оберіть їх у повному аркуші.</span>{{/unless}}{{/unless}}{{/unless}}
  </section>

  {{!-- «Вантаж»: chips «назва · к-сть×ціна · далека · сума ×»; a click on a chip edits its row in place; a new row opens edited --}}
  <section class="pust-block pust-ccmp-cargo">
    <h3><i class="fa-solid fa-boxes-stacked pust-qic" aria-hidden="true"></i>Вантаж <small class="pust-cmp-pkn {{#if v.cargoOver}}bad{{/if}}">{{v.cargoNow}}(к){{#if v.cargoOver}} · перевантаження{{/if}}</small>
      {{#if editable}}<button type="button" class="pust-go pust-cmp-add" data-action="cact" data-act="addCargo" title="Додати рядок вантажу чи пасажира"><i class="fa-solid fa-plus"></i> Рядок</button>{{/if}}</h3>
    <div class="pust-ccmp-sum"><span title="За скільки можна продати весь вантаж">Сума продажу <b>{{#if v.repair.destroyed}}0{{else}}{{#if v.cargoSummary}}{{v.cargoSummary.sale}}{{else}}0{{/if}}{{/if}}(к)</b>{{#if v.cargoSummary.passengers}} · пасажирів: {{v.cargoSummary.passengers}}{{/if}}</span><span class="pust-meter {{#if v.cargoOver}}warn{{/if}}"><span style="width: {{v.cargoPct}}%"></span></span></div>
    <div class="pust-cmp-chips">
      {{#each ccmp.cargo}}
      {{#if edit}}
      <div class="pust-ccmp-cgedit">
        <input type="text" data-k="cargo.{{i}}.name" value="{{name}}" placeholder="Що везете" aria-label="Назва">
        <select data-k="cargo.{{i}}.kind" aria-label="Тип"><option value="cargo" {{#unless pass}}selected{{/unless}}>Вантаж</option><option value="pass" {{#if pass}}selected{{/if}}>Пасажир</option></select>
        <input type="text" class="pust-price" data-k="cargo.{{i}}.price" value="{{price}}" placeholder="Ціна" aria-label="Ціна">
        {{#unless pass}}<input type="text" class="pust-qty" data-k="cargo.{{i}}.qty" value="{{qty}}" placeholder="К-сть" aria-label="Кількість">
        <label title="Далека доставка (понад 15 клітин): продаж ×2 замість ×1,5"><input type="checkbox" data-k="cargo.{{i}}.far" {{#if far}}checked{{/if}}> далека</label>
        <label title="Вантаж пошкоджено: продаж ×1,25 (далека — ×1,5)"><input type="checkbox" data-k="cargo.{{i}}.hurt" {{#if hurt}}checked{{/if}}> пошк.</label>{{/unless}}
        <button type="button" class="pust-ccmp-ok" data-action="cargoEdit" data-i="-1" title="Готово" aria-label="Готово"><i class="fa-solid fa-check"></i></button>
      </div>
      {{else}}
      <span class="pust-cmp-gc kind-{{#if pass}}gear{{else}}boom{{/if}} pust-ccmp-gc"><button type="button" class="pust-ccmp-gn" data-action="cargoEdit" data-i="{{i}}" title="{{#if note}}{{note}} · {{/if}}Змінити рядок"><b>{{#if pass}}Пасажир: {{/if}}{{#if name}}{{name}}{{else}}без назви{{/if}}</b></button>{{#unless pass}}{{#if price}}<span class="pust-cmp-gq">{{#if qty}}{{qty}}×{{/if}}{{price}}(к)</span>{{/if}}{{#if far}}<span class="pust-ccmp-far">далека</span>{{/if}}{{#if hurt}}<span class="pust-ccmp-hurt">пошк.</span>{{/if}}{{/unless}}{{#if sum}}<span class="pust-cmp-gp">{{sum}}</span>{{/if}}{{#if @root.editable}}<button type="button" class="pust-cmp-gx" data-action="cact" data-act="cg-del" data-i="{{i}}" data-confirm="1" title="Прибрати «{{#if name}}{{name}}{{else}}без назви{{/if}}» (натисніть двічі)" aria-label="Прибрати «{{#if name}}{{name}}{{else}}без назви{{/if}}»"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>
      {{/if}}
      {{else}}<span class="pust-sub">Порожньо. За замовчуванням у караван влазить добра на суму до 10 кришок.</span>{{/each}}
    </div>
  </section>

  {{else}}

  {{!-- ===== Аркуш: file, random, quick start, clear (folds; above the name) ===== --}}
  <details class="pust-sheetbar pust-fold" data-fold="sheetBarOpen" {{#if ui.sheetBarOpen}}open{{/if}}>
    <summary title="Розгорнути чи згорнути"><i class="fa-solid fa-chevron-right pust-fold-ico"></i> <i class="fa-solid fa-file-lines"></i> Аркуш</summary>
    <div class="pust-sheetbar-btns">
      <button type="button" data-action="jsonOpen" {{#if qsLock}}data-locked="1" aria-disabled="true"{{/if}} title="{{#if qsLock}}{{qsLock}}{{else}}Відкрити .json{{/if}}"><i class="fa-solid fa-folder-open"></i><span class="pust-sbl"> Відкрити .json</span></button>
      <button type="button" data-action="jsonSave" title="Зберегти .json"><i class="fa-solid fa-floppy-disk"></i><span class="pust-sbl"> Зберегти .json</span></button>
      <button type="button" class="pust-random" data-action="cact" data-act="random" data-confirm="1" {{#if qsLock}}data-locked="1" aria-disabled="true"{{/if}} title="{{#if qsLock}}{{qsLock}}{{else}}Випадковий караван: усе, навіть заповнене вручну, буде перекинуто (транспорт і Удача партії лишаються){{/if}}"><i class="fa-solid fa-dice"></i><span class="pust-sbl"> Випадковий караван</span></button>
      <button type="button" data-action="cact" data-act="clear" data-confirm="1" class="pust-danger" {{#if qsLock}}data-locked="1" aria-disabled="true"{{/if}} title="{{#if qsLock}}{{qsLock}}{{else}}Очистити аркуш{{/if}}"><i class="fa-solid fa-eraser"></i><span class="pust-sbl"> Очистити аркуш</span></button>
      <button type="button" data-action="uiToggle" data-key="guide" title="Як створити караван"><i class="fa-solid fa-circle-question"></i><span class="pust-sbl"> Як створити караван</span></button>
    </div>
  </details>

  {{#if v.guide}}
  <section class="pust-block pust-guide">
    <h3>Як створити караван</h3>
    <ol>{{#each v.guide}}<li>{{t}}</li>{{/each}}</ol>
  </section>
  {{/if}}

  {{!-- ===== Караван: назва, транспорт, Удача, карма, репутація ===== --}}
  <header class="pust-head">
    <div class="pust-who">
      <div class="pust-row">
        <input type="text" class="pust-name" data-k="companyName" value="{{v.name}}" placeholder="Вигадайте назву" aria-label="Назва компанії">
        <span class="pust-seg pust-cmp-seg" role="group" aria-label="Вигляд аркуша"><button type="button" class="on" data-action="compactToggle" data-v="0" title="Повний аркуш: створення й налаштування каравану">Повний</button><button type="button" data-action="compactToggle" data-v="1" title="Компактний аркуш: лише потрібне в дорозі">Компактний</button></span>
        {{#if undo}}<button type="button" class="pust-undo" data-action="undo" title="Повернути аркуш, яким він був до останньої дії"><i class="fa-solid fa-rotate-left"></i> Скасувати</button>{{/if}}
        <button type="button" class="pust-die {{#if v.locks.name}}locked{{/if}}" data-action="cact" data-act="rollName" title="{{#if v.locks.name}}Заповнено вручну. Очистіть поле, щоб знову кидати кістки{{else}}Кинути на назву компанії{{/if}}"><i class="fa-solid {{#if v.locks.name}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
      </div>
      <div class="pust-row pust-vrow">
        <span class="pust-luck">
          <button type="button" class="pust-luck-roll" data-action="cact" data-act="rollFate" title="Удача партії: підсумуйте УДЧ усіх персонажів. −4 і нижче → −2; −3 або −2 → −1; від −1 до +1 → 0; +2 або +3 → +1; +4 і вище → +2.&#10;Клацніть, щоб кинути Кістку Долі: 1d10 + Удача партії, 6 і вище — на користь персонажів."><i class="fa-solid fa-dice-d10"></i> Удача партії</button>
          <select data-k="luck" aria-label="Удача партії">{{#each v.luck}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
        </span>
        <span class="pust-veh">
          <span class="pust-hlab">Транспорт</span>
          <span class="pust-seg">
            {{!-- the HTML caravan sheet's icons: a cow's head, a car (author, 2026-11-15); the two buttons one width --}}
            <button type="button" class="{{#unless v.tachka}}on{{/unless}}" data-action="cact" data-act="veh" data-veh="0"><svg class="veh-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 7c-1.2 -1 -1.7 -2.6 -1.2 -4"/><path d="M15.5 7c1.2 -1 1.7 -2.6 1.2 -4"/><path d="M8 7h8a1 1 0 0 1 1 1v5h-10v-5a1 1 0 0 1 1 -1z"/><path d="M7 8.6l-3.2 -.8l1.2 2.6l2 .4"/><path d="M17 8.6l3.2 -.8l-1.2 2.6l-2 .4"/><path d="M8.5 13h7a1.5 1.5 0 0 1 1.5 1.5v1.5a3 3 0 0 1 -3 3h-4a3 3 0 0 1 -3 -3v-1.5a1.5 1.5 0 0 1 1.5 -1.5z"/><path d="M10 10v.01m4 0v.01"/><path d="M10.3 16.2v.01m3.4 0v.01"/></svg><span>Браміни</span></button>
            <button type="button" class="{{#if v.tachka}}on{{/if}}" data-action="cact" data-act="veh" data-veh="1"><svg class="veh-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5"/></svg><span>Тачка</span></button>
          </span>
        </span>
      </div>
      <div class="pust-row pust-aspect asp-goal">
        <label>Карма</label>
        <select data-k="karmaAspect" aria-label="Кармічний аспект">{{#each v.karmaAspects}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
        <span class="pust-karma">
          <button type="button" data-action="cact" data-act="step" data-step="karma" data-d="-1" title="Мінус 1 карми">−</button>
          <input type="text" class="pust-screen" data-k="karma" value="{{v.karma}}" aria-label="Карма" title="Карма">
          <button type="button" data-action="cact" data-act="step" data-step="karma" data-d="1" title="Плюс 1 карми">+</button>
        </span>
        <button type="button" class="pust-die" data-action="cact" data-act="rollKarma" data-confirm="1" title="Кинути d6 на карму (натисніть двічі): 1 — темні особи, 2–4 — прості волоцюги, 5–6 — гідні люди"><i class="fa-solid fa-dice"></i></button>
      </div>
      <div class="pust-row pust-aspect asp-concept">
        <label>Репутація</label>
        <textarea class="pust-asp-ta" rows="1" data-k="reputation" aria-label="Репутація">{{v.reputation}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.rep}}locked{{/if}}" data-action="cact" data-act="rollRep" title="{{#if v.locks.rep}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути репутаційний аспект{{/if}}"><i class="fa-solid {{#if v.locks.rep}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
      </div>
    </div>
  </header>

  {{!-- ===== Швидкий доступ ===== --}}
  <section class="pust-quickbar {{#if quickFold}}folded{{/if}}">
    <button type="button" class="pust-qfold" data-action="uiToggle" data-key="quickFold" title="{{#if quickFold}}Розгорнути швидкий доступ{{else}}Згорнути швидкий доступ{{/if}}"><i class="fa-solid {{#if quickFold}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i></button>
    {{!-- folded: the main numbers in one line (author, 2026-11-14) --}}
    <div class="pust-qsummary">
      <span class="{{#if (lt v.hpCurrent 1)}}bad{{/if}}">ОЗ <b>{{v.hpCurrent}}/{{v.maxHP}}</b></span>
      <span>Броня <b>{{v.armor}}</b></span>
      <span>Бюджет <b>{{v.budget}}</b><small>(к)</small></span>
      <span>Запас ходу <b>{{v.moveNow}}</b></span>
      {{#if v.repair}}<span class="{{#if v.repair.hurt}}bad{{else}}hurt{{/if}}"><i class="fa-solid fa-screwdriver-wrench"></i> Пошкоджено на <b>{{v.repair.dmg}}</b> ОЗ</span>{{/if}}
    </div>
    <div class="pust-qgrid">
      {{!-- one block (author, 2026-11-14): ОЗ, броня, бюджет, запас ходу in a row; the caravan state under them --}}
      <div class="pust-qgrp q-all">
        <div class="pust-qi q-hp {{#if (lt v.hpCurrent 1)}}bad{{/if}}"><span><i class="fa-solid fa-heart-pulse pust-qic" aria-hidden="true"></i>Очки здоров'я</span><div>
          <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="-1" title="Мінус 1 ОЗ">−</button>
          <input type="text" class="pust-screen" data-k="hpCurrent" value="{{v.hpCurrent}}" aria-label="Поточні ОЗ">
          <b title="Максимум ОЗ: за правилами {{v.baseMaxHP}} плюс надбавка з «Налаштування → Захист»">/ {{v.maxHP}}</b>
          <button type="button" data-action="cact" data-act="step" data-step="hpCurrent" data-d="1" title="Плюс 1 ОЗ">+</button>
        </div></div>
        <div class="pust-qi q-arm"><span><i class="fa-solid fa-shield-halved pust-qic" aria-hidden="true"></i>Броня</span><div class="pust-qarm" title="Броня: за правилами {{v.baseArmor}} плюс надбавка з «Налаштування → Захист»"><b class="big arm-phys">{{v.armor}}</b><small class="arm-phys">фізична</small></div>{{#if v.defChips.length}}<span class="pust-defchips">{{#each v.defChips}}<span class="pust-dchip {{cls}}" title="{{tip}}">{{t}}</span>{{/each}}</span>{{/if}}</div>
        <div class="pust-qi q-bud"><span><i class="fa-solid fa-coins pust-qic" aria-hidden="true"></i>Бюджет кришок</span><div>
          <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="-1" title="Мінус 1 кришка">−</button>
          <input type="text" class="pust-screen" data-k="budget" value="{{v.budget}}" aria-label="Бюджет кришок">
          <button type="button" data-action="cact" data-act="step" data-step="budget" data-d="1" title="Плюс 1 кришка">+</button>
          <button type="button" class="pust-die {{#if v.locks.budget}}locked{{/if}}" data-action="cact" data-act="rollBudget" title="{{#if v.locks.budget}}Заповнено вручну. Змініть бюджет, щоб знову кидати кістки{{else}}Кинути 1d6 + 4{{/if}}"><i class="fa-solid {{#if v.locks.budget}}fa-lock{{else}}fa-dice{{/if}}"></i></button>
        </div></div>
        <div class="q-staterow"><p class="pust-qstate {{#if v.repair}}hurt{{/if}} {{#if v.repair.hurt}}bad{{/if}} {{#if v.repair.destroyed}}bad{{/if}}">{{#if v.repair}}<i class="fa-solid fa-screwdriver-wrench"></i> Пошкоджено на <b>{{v.repair.dmg}}</b> ОЗ{{#unless editable}} · ремонт у техніка: <b>{{v.repair.cost}}(к)</b> (1(к) за 5 ОЗ){{/unless}}{{#if v.repair.hurt}} · <b>вантаж постраждав</b>: шкоди більше ніж на половину ОЗ{{/if}}{{#if v.repair.destroyed}} · <b>ОЗ 0 — вантаж знищено</b>{{/if}}{{else}}<i class="fa-solid fa-circle-check"></i> Караван цілий{{/if}}</p>{{#if editable}}<button type="button" class="pust-refill-btn pust-repair-btn" data-action="cact" data-act="repair" title="{{v.repairBtn.title}}" {{#if v.repairBtn.off}}disabled{{/if}}><i class="fa-solid fa-screwdriver-wrench"></i> {{v.repairBtn.label}}</button>{{/if}}</div>
      </div>
      <div class="pust-qgrp q-move">
        <div class="pust-qi q-movecell"><span><i class="fa-solid fa-route pust-qic" aria-hidden="true"></i>Запас ходу <b class="q-movenow">{{v.moveNow}}</b>{{#if editable}}<button type="button" class="pust-refill-btn" data-action="cact" data-act="refill" title="{{v.refillBtn.title}}" {{#if v.refillBtn.off}}disabled{{/if}}><i class="fa-solid fa-gas-pump"></i> {{v.refillBtn.label}}</button>{{/if}}</span>
          <div class="q-moverow">
            <div class="pust-qpips">
            {{#each v.movePips1}}{{#if avail}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" {{#unless avail}}disabled{{/unless}}></button>{{/if}}{{/each}}
            {{#each v.movePips2}}{{#if avail}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="move" data-i="{{k}}" {{#unless avail}}disabled{{/unless}}></button>{{/if}}{{/each}}
            </div>
          </div>
          <small class="q-refill {{#if v.moveLack}}low{{/if}}">{{v.refill}} · {{v.cellRule}}</small><div class="q-autorow">{{#if editable}}<button type="button" class="pust-autorange {{#if autoRange}}on{{/if}}" data-action="autoRange" role="switch" aria-checked="{{#if autoRange}}true{{else}}false{{/if}}" title="Витрачати автоматично: коли караван переміщують на мапі, запас ходу списується сам, без питання (1 клітина — 1 одиниця, тачка — 3 клітини за одиницю). Якщо запасу бракує, караван лишається на місці."><span class="pust-place-sw" aria-hidden="true"></span><span>Витрачати автоматично</span></button>{{/if}}</div>{{#if brahmins.taken}}<div class="q-brahmins"><span class="q-brah-name">{{#if brahmins.tachka}}Паливний регулятор{{else}}Породисті браміни{{/if}}</span>{{#if editable}}<span class="pust-seg2"><button type="button" class="{{#if brahmins.range}}on{{/if}}" data-action="brahminBonus" data-v="range" title="Караван витрачає менше запасу ходу: на чверть, з «Першопроходцем» — наполовину (витрата округлюється вгору, щонайменше 1 одиниця); списання на мапі це враховує">−{{brahmins.share}} запасу</button><button type="button" class="{{#unless brahmins.range}}on{{/unless}}" data-action="brahminBonus" data-v="time" title="Шлях займає менше часу: на чверть, з «Першопроходцем» — наполовину; запас ходу витрачається повністю">−{{brahmins.share}} часу</button></span><span class="pust-seg2"><button type="button" class="{{#if brahmins.pathfinder}}on{{/if}}" data-action="pathfinder" aria-pressed="{{#if brahmins.pathfinder}}true{{else}}false{{/if}}" title="У когось із персонажів є перк «Першопроходець»: бонус зростає до половини"><i class="fa-solid {{#if brahmins.pathfinder}}fa-square-check{{else}}fa-square{{/if}}"></i> Першопроходець</button></span>{{else}}<b>−{{brahmins.share}} {{#if brahmins.range}}запасу ходу{{else}}часу{{/if}}</b>{{/if}}</div>{{/if}}</div>
      </div>
    </div>

  </section>

  <nav class="pust-tabs">
    <a data-action="pustTab" data-tab="imps" class="{{#if (eq tab 'imps')}}active{{/if}}">Покращення</a>
    <a data-action="pustTab" data-tab="cargo" class="{{#if (eq tab 'cargo')}}active{{/if}}">Вантаж і пасажири</a>
    <a data-action="pustTab" data-tab="story" class="{{#if (eq tab 'story')}}active{{/if}}">Історія</a>
    <a data-action="pustTab" data-tab="settings" class="pust-tab-ico {{#if (eq tab 'settings')}}active{{/if}}" title="Налаштування" aria-label="Налаштування"><i class="fa-solid fa-gear"></i></a>
  </nav>

  <div class="pust-body">

  {{!-- ===== Покращення ===== --}}
  {{#if (eq tab 'imps')}}
    <div class="pust-tools pust-tools-top pust-imp-bar">
      <span class="pust-hcount {{#if v.impNeed}}bad{{/if}}" title="Покращень у каравана"><span>Покращень</span><b>{{v.impCount}}</b><small>{{v.impHint}}</small></span>
      <button type="button" class="pust-fold" data-action="uiToggle" data-key="foldImps" title="{{#if v.foldImps}}Показати всі покращення{{else}}Показати лише взяті{{/if}}"><i class="fa-solid {{#if v.foldImps}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i> {{#if v.foldImps}}Усі покращення{{else}}Лише взяті{{/if}}</button>
      <button type="button" class="pust-die {{#if v.locks.imps}}locked{{/if}}" data-action="cact" data-act="rollImps" data-confirm="1" title="{{#if v.locks.imps}}Покращення обрано вручну. Зніміть усі позначки, щоб знову кидати{{else}}Обрати 2 випадкові покращення замість поточних{{/if}}"><i class="fa-solid {{#if v.locks.imps}}fa-lock{{else}}fa-dice{{/if}}"></i> 2 випадкові</button>
    </div>
    {{#if v.foldEmpty}}<p class="pust-sub">Покращень ще не взято. Розгорніть список, щоб обрати.</p>{{/if}}
    {{#each v.imps}}
    {{#unless hidden}}
    <div class="pust-item pust-card pust-imp {{#if taken}}taken{{/if}} {{#if locked}}locked{{/if}}">
      <div class="pust-item-head">
        <b>{{name}}</b>
        {{#if sub}}<small class="pust-sub">{{sub}}</small>{{/if}}
        {{#if (eq id "turret")}}{{#if @root.turret}}<span class="pust-turret">{{#if @root.editable}}<button type="button" class="pust-turret-dice {{@root.turret.tcls}}" data-action="turretRoll" title="Кинути шкоду турелі в чат"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i>{{@root.turret.diceText}}</button>{{else}}<span class="pust-turret-dice {{@root.turret.tcls}}">{{@root.turret.diceText}}</span>{{/if}}<span class="pust-turret-type {{@root.turret.tcls}}">{{@root.turret.typeLabel}}</span>{{#if @root.editable}}<button type="button" class="pust-turret-hit" data-action="turretHit" title="Вистрілити з турелі по цілях: броня й стійкості кожного враховуються"><i class="fa-solid fa-crosshairs"></i><span>Завдати цілям</span></button>{{/if}}</span>{{/if}}{{/if}}
        {{#if (eq id "defib")}}{{#if taken}}<span class="pust-imp-defib{{#if @root.defib.used}} used{{/if}}">{{#if @root.defib.used}}<span class="pust-pkuse-usedtag" title="Повернеться після «Кінця сцени» Доглядача">використано</span>{{#if @root.editable}}<button type="button" class="pust-pkuse-free" data-action="defib" data-v="0" title="Зняти позначку «використано»"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}{{else if @root.editable}}<button type="button" class="pust-pkuse-go" data-action="defib" data-v="1" title="Застосувати: позначений ціллю (T) персонаж з 0 ОЗ повертається в сцену з 1 ОЗ; картка в чат і позначка до кінця сцени. Одиницю Припасів зніміть самі.">Застосувати</button>{{/if}}</span>{{/if}}{{/if}}
        <span class="pust-imp-ctrl">
          {{#if supPips}}<span class="pust-pips">{{#each supPips}}<button type="button" class="pip {{#if on}}on{{/if}}" data-action="cact" data-act="pip" data-pip="sup" data-i="{{k}}"></button>{{/each}}</span>{{/if}}
          {{#each btns}}<button type="button" class="rbtn {{#if on}}on{{/if}}" data-action="cact" data-act="imp" data-id="{{../id}}" data-k="{{k}}" {{#if ../locked}}disabled{{/if}}></button>{{/each}}
        </span>
      </div>
      <div class="pust-text">{{desc}}</div>
    </div>
    {{/unless}}
    {{/each}}
    {{#each v.customImps}}
    <div class="pust-item pust-card pust-imp taken custom">
      <div class="pust-item-head">
        <input type="text" class="pust-imp-name" data-k="customImps.{{i}}.name" value="{{name}}" placeholder="Назва" aria-label="Назва покращення">
        <small class="pust-sub">Власне покращення</small>
        <button type="button" class="pust-x" data-action="cact" data-act="cimp-del" data-i="{{i}}" data-confirm="1" title="Видалити власне покращення"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <textarea class="pust-asp-ta" rows="1" data-k="customImps.{{i}}.desc" placeholder="Що воно дає каравану" aria-label="Опис покращення">{{desc}}</textarea>
    </div>
    {{/each}}
    <div class="pust-tools"><button type="button" data-action="cact" data-act="addCustomImp">+ Власне покращення</button></div>
  {{/if}}

  {{!-- ===== Вантаж і пасажири ===== --}}
  {{#if (eq tab 'cargo')}}
    <div class="pust-tools pust-tools-top pust-cargo-bar">
      <span class="pust-hcount {{#if v.cargoOver}}bad{{/if}}" title="Вантаж на суму / місткість каравану"><span>Вантаж</span><b>{{v.cargoNow}}</b><small>(к)</small><span class="pust-meter {{#if v.cargoOver}}warn{{/if}}"><span style="width: {{v.cargoPct}}%"></span></span>{{#if v.cargoOver}}<small>перевантаження</small>{{/if}}</span>
      <span class="pust-hcount pust-hsale {{#if v.cargoSummary.hurt}}hurt{{/if}} {{#if v.repair.destroyed}}hurt{{/if}}" title="{{#if v.repair.destroyed}}ОЗ 0 — вантаж знищено: продавати нічого{{else}}За скільки можна продати весь вантаж: сума рядків, кожен зі своєю далекою доставкою й пошкодженням{{/if}}"><span>Сума продажу</span><b>{{#if v.repair.destroyed}}0{{else}}{{#if v.cargoSummary}}{{v.cargoSummary.sale}}{{else}}0{{/if}}{{/if}}</b><small>(к){{#if v.cargoSummary.passengers}} · пасажирів: {{v.cargoSummary.passengers}}{{/if}}</small></span>
    </div>
    {{#if v.cargo.length}}
    <div class="pust-glist pust-glist-cargo">
      <div class="pust-grow pust-ghead"><span>Назва</span><span>Примітка</span><span>Тип</span><span>Ціна</span><span>К-сть</span><span title="Далека доставка (понад 15 клітин): ×2 замість ×1,5">Далека</span><span title="Вантаж пошкоджено: ×1,25 (далека — ×1,5)">Пошк.</span><span title="За скільки продасться рядок">Сума</span><span><i class="fa-solid fa-xmark"></i></span></div>
      {{#each v.cargo}}
      <div class="pust-grow">
        <textarea class="pust-gname pust-gnote-in pust-cname" rows="1" data-k="cargo.{{i}}.name" placeholder="Що везете" aria-label="Назва">{{name}}</textarea>
        <textarea class="pust-gnote-in pust-cnote" rows="1" data-k="cargo.{{i}}.note" placeholder="Куди, кому, умови" aria-label="Куди, кому, умови">{{note}}</textarea>
        <select data-k="cargo.{{i}}.kind" aria-label="Тип"><option value="cargo" {{#unless pass}}selected{{/unless}}>Вантаж</option><option value="pass" {{#if pass}}selected{{/if}}>Пасажир</option></select>
        <input type="text" class="pust-price" data-k="cargo.{{i}}.price" value="{{price}}" placeholder="Ціна" aria-label="Ціна">
        <input type="text" class="pust-qty" data-k="cargo.{{i}}.qty" value="{{qty}}" placeholder="К-сть" aria-label="Кількість">
        {{#if pass}}<span></span><span></span>{{else}}<label class="pust-ctick" title="Далека доставка (понад 15 клітин): продаж ×2 замість ×1,5"><input type="checkbox" data-k="cargo.{{i}}.far" {{#if far}}checked{{/if}} aria-label="Далека доставка"></label>
        <label class="pust-ctick" title="Вантаж пошкоджено: продаж ×1,25 (далека — ×1,5). Ставиться сам, коли караван отримує понад половину ОЗ шкоди"><input type="checkbox" data-k="cargo.{{i}}.hurt" {{#if hurt}}checked{{/if}} aria-label="Пошкоджено"></label>{{/if}}
        <b class="pust-csum {{#if hurt}}{{#unless pass}}hurt{{/unless}}{{/if}}" title="{{#if pass}}Плата за проїзд{{else}}Ціна продажу рядка{{/if}}">{{sum}}</b>
        <button type="button" class="pust-x" data-action="cact" data-act="cg-del" data-i="{{i}}" data-confirm="1" title="Видалити рядок"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="pust-sub">Порожньо. За замовчуванням у караван влазить добра на суму до 10 кришок.</p>
    {{/if}}
    <div class="pust-tools">
      <button type="button" data-action="cact" data-act="addCargo">+ Рядок</button>
    </div>

  {{/if}}

  {{!-- no «Лічильники» tab (author, 2026-11-16): the counters live in the panel «Лічильники»; a .json's counters are kept --}}

  {{!-- ===== Історія каравану ===== --}}
  {{#if (eq tab 'story')}}
    <div class="pust-story">
      <div class="pust-row pust-aspect asp-concept"><label>Як ви познайомилися?</label><textarea class="pust-asp-ta" rows="1" data-k="story.meeting" aria-label="Як ви познайомилися?">{{v.story.meeting}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.meeting}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="meeting" title="{{#if v.locks.meeting}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.meeting}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
      <div class="pust-row pust-aspect asp-detail"><label>Обличчя компанії</label><textarea class="pust-asp-ta" rows="1" data-k="story.face" aria-label="Обличчя компанії">{{v.story.face}}</textarea></div>
      <div class="pust-row pust-aspect asp-goal"><label>Остання справа</label><textarea class="pust-asp-ta" rows="1" data-k="story.lastJob" aria-label="Остання справа">{{v.story.lastJob}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.lastJob}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="lastJob" title="{{#if v.locks.lastJob}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.lastJob}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
      <div class="pust-row pust-aspect asp-problem"><label>Що пішло не так</label><textarea class="pust-asp-ta" rows="1" data-k="story.wentWrong" aria-label="Що пішло не так">{{v.story.wentWrong}}</textarea>
        <button type="button" class="pust-die {{#if v.locks.wentWrong}}locked{{/if}}" data-action="cact" data-act="roll" data-roll="wentWrong" title="{{#if v.locks.wentWrong}}Заповнено вручну. Очистіть поле, щоб знову кидати{{else}}Кинути кістки{{/if}}"><i class="fa-solid {{#if v.locks.wentWrong}}fa-lock{{else}}fa-dice{{/if}}"></i></button></div>
    </div>
    <h4>Примітки</h4>
    {{!-- Foundry's own editor with its formatting tools, as the character sheet's «Записи» (author, 2026-11-15) --}}
    <prose-mirror class="pust-notes-ed" data-note="notes" value="{{v.notes}}"></prose-mirror>
  {{/if}}

  {{!-- ===== Налаштування: Захист (Foundry only, author 2026-11-14; like the character sheet's «Ручні надбавки» + «Захист вручну») ===== --}}
  {{#if (eq tab 'settings')}}
    {{!-- two blocks side by side, as the character sheet's «Ручні надбавки» / «Захист вручну» (author, 2026-11-15) --}}
    <div class="pust-car-reset"><button type="button" data-action="cact" data-act="def-reset" data-confirm="1" title="Прибрати обидві надбавки й повернути захист до звичайного (натисніть двічі)"><i class="fa-solid fa-rotate-left"></i> Повернути все до стандартних значень</button></div>
    <div class="pust-cols pust-settings pust-car-settings">
      <section class="pust-block">
        <h3><i class="fa-solid fa-screwdriver-wrench"></i> Надбавки{{#if v.settings.set}} <small class="pust-fold-n">задано: {{v.settings.set}}</small>{{/if}}</h3>
        <div class="pust-ovgrid">
          {{#each v.settings.bonuses}}
          <div class="pust-ovrow">
            <span>{{n}}</span>
            <span class="pust-ovstep">
              <button type="button" data-action="cact" data-act="step" data-step="{{k}}" data-d="-1" title="Мінус 1">−</button>
              <input type="text" class="pust-screen" data-k="{{k}}" value="{{val}}" placeholder="—" aria-label="{{n}}" title="{{#if tip}}{{tip}}{{else}}Ціле число, може бути від'ємним; порожньо — без надбавки (за правилами {{base}}){{/if}}">
              <button type="button" data-action="cact" data-act="step" data-step="{{k}}" data-d="1" title="Плюс 1">+</button>
            </span>
            {{#if val}}<button type="button" class="pust-ovreset" data-action="cact" data-act="ov-reset" data-k="{{k}}" title="Скинути до стандартного значення"><i class="fa-solid fa-rotate-left"></i></button>{{else}}<span></span>{{/if}}
          </div>
          {{/each}}
        </div>
        <p class="pust-sub pust-set-hint">Порожньо — за правилами. Максимум ОЗ і броня каравану не редагуються напряму: надбавка (можна від'ємну) додається до того, що порахував аркуш за транспортом і покращеннями.</p>
        {{#if turret}}
        <h4><i class="fa-solid fa-crosshairs"></i> Турель</h4>
        <div class="pust-turretset">
          <label><span>Шкода</span><input type="text" class="pust-screen" data-tf="dice" value="{{turret.dice}}" placeholder="2d6" aria-label="Шкода турелі" title="Кістки шкоди турелі, напр. 2d6, 3d6+2; за правилами 2d6 (важка зброя)"></label>
          <label><span>Тип</span><select data-tf="type" aria-label="Тип шкоди турелі">{{#each turret.typeOpts}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>
        </div>
        {{/if}}
      </section>
      <section class="pust-block pust-setstack-like">
        <h3><i class="fa-solid fa-shield-halved"></i> Захист{{#if v.settings.defSet}} <small class="pust-fold-n">змінено: {{v.settings.defSet}}</small>{{/if}}</h3>
        <div class="pust-defgrid">
          {{#each v.settings.defTypes}}<label class="pust-defrow"><span>{{n}}</span><select data-k="defOv.{{k}}">{{#each options}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>{{/each}}
        </div>
      </section>
    </div>
  {{/if}}

  </div>
{{/if}}
</div>
