{{!-- Картка супротивника (Foundry): усе, що має картка з трекера битви --}}
<div class="pust-sheet-inner pust-en {{#unless editable}}readonly{{/unless}} {{#if edit}}editing{{/if}}" style="--kc: {{v.catColor}}">
  <header class="pust-en-hd">
    <img class="pust-en-pic" src="{{img}}" alt="{{name}}" {{#if editable}}data-action="pickImg" title="Змінити зображення"{{/if}}>
    <div class="pust-en-who">
      <div class="pust-en-namerow">
        {{#if editable}}
        <input class="pust-en-name" type="text" name="name" value="{{name}}" placeholder="Назва супротивника" autocomplete="off" aria-label="Назва">
        {{#if canName}}<button type="button" class="pust-die" data-action="rndName" title="Випадкове ім'я, що пасує цьому супротивникові" aria-label="Випадкове ім'я"><i class="fa-solid fa-dice"></i></button>{{/if}}
        {{else}}<span class="pust-en-name ro">{{name}}</span>{{/if}}
      </div>
      <div class="pust-en-bar">
        <span class="pust-en-cat">{{{v.catIcon}}}{{v.catLabel}}</span>
        <span class="pust-en-sp"></span>
        {{#if gm}}{{#if world}}<button type="button" class="pust-en-sw pust-en-reveal {{#if v.reveal}}on{{/if}}" data-action="revealToggle" role="switch" aria-checked="{{#if v.reveal}}true{{else}}false{{/if}}"
          title="{{#if v.reveal}}Гравці бачать токени й картку (лише для читання). Натисни, щоб сховати{{else}}Токени й картку від гравців сховано. Натисни, щоб показати{{/if}}">
          <span class="pust-place-sw" aria-hidden="true"></span><i class="fa-solid {{#if v.reveal}}fa-eye{{else}}fa-eye-slash{{/if}}"></i><span>{{#if v.reveal}}Видимий{{else}}Прихований{{/if}}</span></button>{{/if}}{{/if}}
        {{#if gm}}{{#if world}}<button type="button" class="pust-en-sw pust-en-chat" data-action="toChat" title="Надіслати в чат повну картку ворога: ОЗ, броню, захист, атаки, аспекти, ходи й примітки" aria-label="В чат"><i class="fa-solid fa-comment"></i><span>В чат</span></button>{{/if}}{{/if}}
        {{#if editable}}<button type="button" class="pust-en-sw pust-en-edit {{#if edit}}on{{/if}}" data-action="editToggle" title="{{#if edit}}Закрити редактор{{else}}Редагувати атаки, аспекти, ходи й примітки{{/if}}">
          <i class="fa-solid {{#if edit}}fa-check{{else}}fa-pen{{/if}}"></i><span>{{#if edit}}Готово{{else}}Редагувати{{/if}}</span></button>{{/if}}
      </div>
    </div>
  </header>

  {{#if limited}}
  {{!-- what players see of a visible enemy (author, 2026-11-16): its state in words and its situational aspects, nothing more --}}
  <div class="pust-en-body">
    <div class="pust-en-state" style="--sc: {{v.state.color}}" title="Стан ворога"><i class="fa-solid {{v.state.icon}}" aria-hidden="true"></i><span>{{v.state.label}}</span></div>
    {{#if observant}}
    {{!-- «Спостережливість» (author, 2026-11-17): the exact HP and what it is armed with, read-only --}}
    <section class="pust-en-hp pust-en-observant">
      <div class="pust-en-hprow {{#if v.hp.dead}}bad{{/if}}">
        <span class="pust-en-lbl" title="Перк «Спостережливість»: ти завжди знаєш точну кількість ОЗ супротивників"><i class="fa-solid fa-heart-pulse pust-qic" aria-hidden="true"></i>Очки здоров'я</span>
        <div class="pust-en-hpctl"><b class="pust-en-hpnum">{{v.hp.value}} / {{v.hp.max}}</b></div>
      </div>
      <div class="pust-en-hpbar hp-{{v.hp.level}}" title="Очки здоров'я: {{v.hp.value}} з {{v.hp.max}}"><div class="pust-en-hpfill" style="width: {{v.hp.pct}}%"></div></div>
    </section>
    <section class="pust-en-card pust-en-observant">
      <h3 title="Перк «Спостережливість»: ти завжди знаєш, чим озброєні супротивники"><i class="fa-solid fa-burst pust-qic" aria-hidden="true"></i>Атаки</h3>
      {{#each v.attacks}}
      <div class="pust-en-atk">
        <div class="pust-en-atkhd">
          <b class="pust-en-atkn">{{name}}</b>
          <span class="pust-en-dicechip {{tcls}}"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i>{{diceText}}</span>
          <span class="pust-en-type {{tcls}}">{{typeLabel}}</span>
          {{#if extra}}<span class="pust-en-dicechip pust-en-extra {{extra.tcls}}" title="{{extra.title}}">{{extra.text}}</span><span class="pust-en-type {{extra.tcls}}" title="{{extra.title}}">{{extra.label}}</span>{{/if}}
        </div>
        {{#if note}}<div class="pust-en-note">{{note}}</div>{{/if}}
      </div>
      {{else}}<div class="pust-en-muted">Атак немає</div>{{/each}}
    </section>
    {{/if}}
    <section class="pust-en-card">
      <h3><i class="fa-solid fa-tags pust-qic" aria-hidden="true"></i>Ситуативні аспекти</h3>
      <div class="pust-en-chips">
        {{#each v.aspects}}<span class="pust-en-chip{{#if imm}} imm{{/if}}"{{#if imm}} title="Імунітет: {{imm}}"{{/if}}><span>{{t}}</span>{{#if inv}}<b class="pust-asp-n" title="Безкоштовні Посилення">+{{inv}}</b>{{/if}}</span>
        {{else}}<span class="pust-en-muted">Ситуативних аспектів немає</span>{{/each}}
      </div>
    </section>
  </div>
  {{else}}
  <div class="pust-en-body">
    {{!-- Очки здоров'я --}}
    <section class="pust-en-hp">
      <div class="pust-en-hprow {{#if v.hp.dead}}bad{{/if}}">
        <span class="pust-en-lbl"><i class="fa-solid fa-heart-pulse pust-qic" aria-hidden="true"></i>Очки здоров'я</span>
        <div class="pust-en-hpctl">
          {{#if editable}}<button type="button" data-action="hpStep" data-d="-1" title="Мінус 1 ОЗ">−</button>
          <input class="pust-screen" type="text" name="hpCur" value="{{v.hp.value}}" aria-label="Поточні ОЗ">
          <b>/</b><input class="pust-screen pust-en-max" type="text" name="hpMax" value="{{v.hp.max}}" aria-label="Максимум ОЗ" title="Максимум ОЗ">
          <button type="button" data-action="hpStep" data-d="1" title="Плюс 1 ОЗ">+</button>
          {{else}}<b class="pust-en-hpnum">{{v.hp.value}} / {{v.hp.max}}</b>{{/if}}
        </div>
      </div>
      <div class="pust-en-hpbar hp-{{v.hp.level}}" title="Очки здоров'я: {{v.hp.value}} з {{v.hp.max}}"><div class="pust-en-hpfill" style="width: {{v.hp.pct}}%"></div></div>
      <div class="pust-en-badges">
        <span class="pust-en-badge" {{#if v.armorText}}title="Броня за книгою: {{v.armorText}}"{{/if}}><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Броня <b>{{v.armor}}</b></span>
        {{#if v.psiArmor}}<span class="pust-en-badge psi" title="Психічна броня: зменшує кожну психічну шкоду на {{v.psiArmor}}"><i class="fa-solid fa-brain" aria-hidden="true"></i>Пси-броня <b>{{v.psiArmor}}</b></span>{{/if}}
        {{#each v.tags}}<span class="pust-en-tag" title="{{help}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i>{{text}}</span>{{/each}}
      </div>
    </section>

    {{!-- «Отримати шкоду» removed (author, 2026-11-14): damage goes through «Завдати цілям» and the «Битва» panel --}}
    {{!-- Аспекти --}}
    <section class="pust-en-card">
      <h3><i class="fa-solid fa-tags pust-qic" aria-hidden="true"></i>Ситуативні аспекти</h3>
      <div class="pust-en-chips">
        {{#each v.aspects}}<span class="pust-en-chip{{#if imm}} imm{{/if}}"{{#if imm}} title="Імунітет: {{imm}}"{{/if}}><span>{{t}}</span>
          {{#if ../editable}}<span class="pust-en-inv" title="Безкоштовні посилення цього аспекту"><button type="button" data-action="inv" data-s="s" data-i="{{i}}" data-d="-1" aria-label="Мінус посилення">−</button><b>+{{inv}}</b><button type="button" data-action="inv" data-s="s" data-i="{{i}}" data-d="1" aria-label="Плюс посилення">+</button></span>{{else}}{{#if inv}}<b class="pust-asp-n" title="Безкоштовні Посилення">+{{inv}}</b>{{/if}}{{/if}}
          {{#if ../editable}}<button type="button" class="pust-en-x" data-action="aspRm" data-s="s" data-i="{{i}}" aria-label="Прибрати аспект">×</button>{{/if}}</span>
        {{else}}<span class="pust-en-muted">Ситуативних аспектів немає</span>{{/each}}
      </div>
      {{#if editable}}<input class="pust-en-aspin" type="text" maxlength="100" name="aspin" placeholder="+ ситуативний аспект, Enter" autocomplete="off" aria-label="Новий ситуативний аспект">{{/if}}
      {{!-- quick aspects as in the character sheet (author, 2026-11-22; 4.2): under the chips, the ochre buttons (label «Швидкі:», short so the three fit one row at 460 px),
           for whoever may edit the enemy; the others see the chips only --}}
      {{#if editable}}{{#if v.quick.length}}
      <div class="pust-en-quick pust-sitq"><span class="pust-en-sub">Швидкі:</span>
        {{#each v.quick}}<button type="button" class="pust-en-q{{#if imm}} imm{{/if}}" data-action="quickAsp" data-k="{{key}}" title="{{help}}">+ {{label}}</button>{{/each}}
      </div>{{/if}}{{/if}}
    </section>

    {{!-- Атаки --}}
    <section class="pust-en-card">
      <h3><i class="fa-solid fa-burst pust-qic" aria-hidden="true"></i>Атаки</h3>
      {{#if edit}}
      {{#each v.attacks}}
      <div class="pust-en-ed">
        <div class="pust-en-edrow">
          <input type="text" data-af="name" data-i="{{i}}" value="{{name}}" placeholder="Назва атаки" aria-label="Назва атаки">
          <input type="text" class="pust-en-dice" data-af="dice" data-i="{{i}}" value="{{base}}" placeholder="1d10" aria-label="Шкода">
          <button type="button" class="pust-en-x" data-action="rmAtk" data-i="{{i}}" aria-label="Прибрати атаку" title="Прибрати атаку">×</button>
        </div>
        <div class="pust-en-edrow">
          <select data-af="type" data-i="{{i}}" aria-label="Тип шкоди">{{#each typeOpts}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{n}}</option>{{/each}}</select>
          <label class="pust-en-ammo-l" title="Заряди чи штуки (0 — без обмеження)">Заряди <input type="text" class="pust-en-num" data-af="ammoMax" data-i="{{i}}" value="{{ammoMax}}" aria-label="Заряди"></label>
        </div>
        <input type="text" data-af="note" data-i="{{i}}" value="{{noteRaw}}" placeholder="Опис: ігнорує 1 броні, влучає по всіх у зоні…" aria-label="Опис атаки">
      </div>
      {{else}}<div class="pust-en-muted">Атак немає</div>{{/each}}
      <div class="pust-en-edadd">
        <button type="button" data-action="addAtk">+ Атака</button>
        <select name="atkPreset" aria-label="Взяти зразок атаки"><option value="">Зразок: книга, енергетична, гранати, база…</option>
          {{#each atkPresets}}<optgroup label="{{g}}">{{#each items}}<option value="{{v}}">{{n}}{{#if d}} ({{d}}){{/if}}</option>{{/each}}</optgroup>{{/each}}</select>
      </div>
      {{else}}
      {{#each v.attacks}}
      <div class="pust-en-atk {{#if dead}}spent{{/if}}">
        <div class="pust-en-atkhd {{#if extra}}wrap{{/if}}">
          <b class="pust-en-atkn">{{name}}</b>
          {{#if ../editable}}<button type="button" class="pust-en-dicechip {{tcls}}" data-action="rollAtk" data-i="{{i}}" {{#if dead}}disabled{{/if}} title="{{#if dead}}Заряди скінчилися{{else}}Кинути шкоду цієї атаки в чат{{/if}}"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i>{{diceText}}</button>{{else}}<span class="pust-en-dicechip {{tcls}}" title="Кістки шкоди">{{diceText}}</span>{{/if}}
          {{#if plus}}<span class="pust-en-plus" title="{{plusTitle}}">{{plusText}}</span>{{/if}}
          <span class="pust-en-type {{tcls}}">{{typeLabel}}</span>
          {{#if extra}}<span class="pust-en-dicechip pust-en-extra {{extra.tcls}}" title="{{extra.title}}">{{extra.text}}</span><span class="pust-en-type {{extra.tcls}}" title="{{extra.title}}">{{extra.label}}</span>{{/if}}
          {{#if ../editable}}<button type="button" class="pust-dmg-apply" data-action="hitSel" data-i="{{i}}" {{#if dead}}disabled{{/if}} title="{{#if dead}}Заряди скінчилися{{else}}Кинути цю атаку й завдати шкоди цілям: броня й стійкості кожного враховуються{{/if}}"><i class="fa-solid fa-crosshairs"></i><span>Завдати цілям</span>{{#if menu}}<i class="fa-solid fa-caret-down pust-pick-caret" aria-hidden="true"></i>{{/if}}</button>{{/if}}
        </div>
        {{#if note}}<div class="pust-en-note">{{note}}</div>{{/if}}
        {{#if ammo}}<div class="pust-en-pips" title="Заряди: {{ammo.value}} з {{ammo.max}}">{{#each ammo.pips}}<button type="button" class="pust-en-pip {{#if on}}on{{/if}}" data-action="pip" data-i="{{../i}}" data-n="{{n}}" aria-label="Заряд {{n}}"></button>{{/each}}<small>{{ammo.value}} / {{ammo.max}}</small></div>{{/if}}
      </div>
      {{else}}<div class="pust-en-muted">Атак немає</div>{{/each}}
      {{#if v.psyMove}}
      {{!-- an indicator only (author, 2026-11-19): the move's «Використати» in «Деталі» turns it on --}}
      <div class="pust-en-psy {{#if v.psycho}}on{{/if}}" title="Хід «{{v.psyMove.n}}»: до кінця сцени +2 шкоди атаками (крім беззбройних і Пси-удару). Вмикає «Використати» цього ходу в «Деталях»">
        <i class="fa-solid fa-syringe"></i> {{#if v.psycho}}Діє Психо <small>+2 шкоди</small>{{else}}Психо не діє <small>«{{v.psyMove.n}}» у «Деталях»</small>{{/if}}</div>
      {{/if}}
      {{/if}}
    </section>

    {{!-- Деталі --}}
    <details class="pust-en-card pust-en-det" data-fold="details" {{#if ui.details}}open{{/if}}>
      <summary><i class="fa-solid fa-book-skull pust-qic" aria-hidden="true"></i>Деталі: аспекти, ходи, примітки{{#if differs}} <span class="pust-en-flag">змінено</span>{{/if}}</summary>
      <h4>Аспекти</h4>
      <div class="pust-en-chips">
        {{#each v.baseAspects}}<span class="pust-en-chip">{{#if ../edit}}<input type="text" class="pust-en-chipin" data-bf="{{i}}" value="{{t}}" size="{{len}}" aria-label="Аспект">{{else}}<span>{{t}}</span>{{/if}}
          {{#if ../editable}}<span class="pust-en-inv" title="Безкоштовні посилення"><button type="button" data-action="inv" data-s="b" data-i="{{i}}" data-d="-1" aria-label="Мінус посилення">−</button><b>+{{inv}}</b><button type="button" data-action="inv" data-s="b" data-i="{{i}}" data-d="1" aria-label="Плюс посилення">+</button></span>{{else}}{{#if inv}}<b class="pust-asp-n" title="Безкоштовні Посилення">+{{inv}}</b>{{/if}}{{/if}}
          {{#if ../edit}}<button type="button" class="pust-en-x" data-action="aspRm" data-s="b" data-i="{{i}}" aria-label="Прибрати аспект">×</button>{{/if}}</span>
        {{else}}<span class="pust-en-muted">Аспектів немає</span>{{/each}}
      </div>
      {{#if edit}}<input class="pust-en-aspin" type="text" maxlength="100" name="baseIn" placeholder="+ аспект, Enter" autocomplete="off" aria-label="Новий аспект">{{/if}}

      <h4>Ходи</h4>
      {{#each v.moves}}
      {{#if ../edit}}
      <div class="pust-en-ed">
        <div class="pust-en-edrow"><input type="text" data-mf="n" data-i="{{i}}" value="{{n}}" placeholder="Назва ходу" aria-label="Назва ходу">
          <button type="button" class="pust-en-x" data-action="rmMove" data-i="{{i}}" aria-label="Прибрати хід" title="Прибрати хід">×</button></div>
        <textarea data-mf="t" data-i="{{i}}" rows="2" placeholder="Що робить хід" aria-label="Опис ходу">{{t}}</textarea>
      </div>
      {{else}}
      {{#if button}}
      {{!-- a move with «Використати» (author, 2026-11-19; mockup А, like the compact sheet's perks: templates/actor/parts/perk-use.hbs);
           every move is a card, the stripe rust for a move with the button, grey for one without (author, 2026-11-20) --}}
      <div class="pust-en-move pust-pkuse pk-{{cls}} pk-act{{#if used}} used{{/if}}">
        <div class="pust-pkuse-top">
          <span class="pust-pkuse-n">{{n}}</span>
          <span class="pust-pklim pk-{{cls}}">{{lim}}{{#if pips}} <span class="pust-mvpips" title="Лишилося використань">{{#each pips}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>{{/if}}</span>
          {{#if ../editable}}<button type="button" class="pust-pkuse-go" data-action="useMove" data-i="{{i}}" {{#if off}}disabled{{/if}} title="{{#if offWhy}}{{offWhy}}{{else}}{{hint}}{{/if}}">Використати</button>{{/if}}
        </div>
        <div class="pust-en-mvt">{{{tHtml}}}</div>
        {{!-- what the button does is its tooltip only, not a line under the text (author, 2026-11-20) --}}
        {{#if used}}<p class="pust-pkuse-t"><b class="pust-pkuse-usedtag">Використано</b> · {{back}}.{{#if ../editable}} <button type="button" class="pust-pkuse-free" data-action="freeMove" data-i="{{i}}" title="Зняти позначку «використано»: хід знову доступний, застосований ефект лишається"><i class="fa-solid fa-rotate-left"></i> Зняти позначку</button>{{/if}}</p>{{else}}{{#if spent}}{{#if again}}<p class="pust-pkuse-t">Використано разів: {{spent}}</p>{{/if}}{{/if}}{{/if}}
      </div>
      {{else}}
      <div class="pust-en-move pust-pkuse pk-passive{{#if gone}} used{{/if}}">
        <div class="pust-pkuse-top">
          <span class="pust-pkuse-n"{{#if hint}} title="{{hint}}"{{/if}}>{{n}}</span>
          {{#if limited}}<span class="pust-pklim pk-{{cls}}">{{lim}}</span>{{/if}}
        </div>
        <div class="pust-en-mvt">{{{tHtml}}}</div>
        {{#if gone}}
        {{!-- a «лишається живим» move already spent this scene (author, 2026-11-20): the GM sees it will not save the enemy again --}}
        <p class="pust-pkuse-t"><b class="pust-pkuse-usedtag">Витрачено</b> · {{back}}.{{#if ../editable}} <button type="button" class="pust-pkuse-free" data-action="freeMove" data-i="{{i}}" title="Зняти позначку «витрачено»: хід знову врятує ворога від 0 ОЗ"><i class="fa-solid fa-rotate-left"></i> Зняти позначку</button>{{/if}}</p>
        {{/if}}
      </div>
      {{/if}}
      {{/if}}
      {{else}}<div class="pust-en-muted">Ходів немає</div>{{/each}}
      {{#if edit}}
      <div class="pust-en-edadd">
        <button type="button" data-action="addMove">+ Хід</button>
        <select name="movePreset" aria-label="Взяти зразок ходу"><option value="">Зразок ходу з бази…</option>{{#each movePresets}}<option value="{{i}}">{{n}}</option>{{/each}}</select>
      </div>
      {{/if}}

      <h4>Інші примітки</h4>
      {{#if edit}}<textarea name="notes" rows="2" placeholder="Інші примітки: будь-який запис…" aria-label="Інші примітки">{{notes}}</textarea>
      {{else}}{{#if notes}}<div class="pust-en-notes">{{{notesHtml}}}</div>{{else}}<div class="pust-en-muted">Приміток немає{{#if editable}} — допиши в «Редагувати»{{/if}}</div>{{/if}}{{/if}}

      {{#if edit}}
      <h4>Категорія</h4>
      <select name="cat" aria-label="Категорія">{{#each cats}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      <div class="pust-en-hint">{{catGuide}}</div>
      {{#if v.canReset}}<button type="button" class="pust-en-reset" data-action="resetBook" title="Повернути атаки, аспекти, ходи, примітки й захист за книгою (ОЗ і ситуативні аспекти лишаються)"><i class="fa-solid fa-rotate-left"></i> Як у книзі</button>{{/if}}
      {{/if}}
    </details>

    {{!-- Захист (Доглядач) --}}
    {{#if gm}}
    <details class="pust-en-card pust-en-det" data-fold="defence" {{#if ui.defence}}open{{/if}}>
      <summary><i class="fa-solid fa-shield-halved pust-qic" aria-hidden="true"></i>Захист</summary>
      <div class="pust-en-defgrid">
        {{#each v.defence}}
        <label class="pust-en-def {{#if chk}}chk{{/if}}"><span>{{label}}</span>
          {{#if num}}<input type="text" class="pust-en-num" data-df="{{f}}" value="{{value}}" aria-label="{{label}}">{{/if}}
          {{#if sel}}<select data-df="{{f}}" aria-label="{{label}}">{{#each options}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{l}}</option>{{/each}}</select>{{/if}}
          {{#if chk}}<input type="checkbox" data-df="{{f}}" {{#if value}}checked{{/if}} aria-label="{{label}}">{{/if}}
        </label>
        {{/each}}
      </div>
