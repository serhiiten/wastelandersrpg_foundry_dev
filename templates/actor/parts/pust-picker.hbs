{{!-- List of perks / feats to add (kind: perk | feat): a search bar on a screen, cards with the name and «Узяти» in one row --}}
<div class="pust-picker">
  <div class="pust-picker-bar">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input type="text" placeholder="Пошук за назвою чи описом" data-ui="q" value="{{q}}">
    <label class="pust-tog"><input type="checkbox" data-ui="showAll" {{#if showAll}}checked{{/if}}> показати недоступні</label>
  </div>
  <div class="pust-picker-list">
  {{#each list}}
  <h4>{{c}} <small>{{list.length}}</small></h4>
  {{#each list}}
  <div class="pust-pick {{#unless ok}}bad{{/unless}}">
    <div class="pust-pick-head">
      <b>{{n}}</b>
      <button type="button" class="pust-pick-add" data-action="act" data-act="{{../../kind}}-add" data-n="{{n}}" {{#unless ok}}title="{{why}}"{{/unless}}><i class="fa-solid {{#if ok}}fa-plus{{else}}fa-lock{{/if}}"></i> Узяти</button>
    </div>
    {{#if req}}<small class="pust-sub pust-req">вимоги: {{req}}</small>{{/if}}
    {{#unless ok}}<small class="pust-pick-why"><i class="fa-solid fa-circle-exclamation"></i> {{why}}</small>{{/unless}}
    <div class="pust-text pust-desc">{{text}}</div>
  </div>
  {{/each}}
  {{else}}
  <p class="pust-sub pust-pick-none">Нічого не знайдено.</p>
  {{/each}}
  </div>
</div>
